{
  "name": "ai-b2b-company-enrichment",
  "version": "0.1.0",
  "description": "Evidence-backed AI enrichment for B2B company accounts with optional ICP scoring.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/1aday/ai-b2b-company-enrichment.git"
  },
  "bugs": {
    "url": "https://github.com/1aday/ai-b2b-company-enrichment/issues"
  },
  "homepage": "https://github.com/1aday/ai-b2b-company-enrichment#readme",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "enrichment",
    "llm",
    "scraping",
    "markdown",
    "openrouter",
    "b2b",
    "company-enrichment",
    "lead-enrichment",
    "sales-intelligence",
    "typescript"
  ],
  "scripts": {
    "flow": "tsx src/run-company-enrichment-flow.ts --preset=company",
    "flow:capital-source": "tsx src/run-company-enrichment-flow.ts --preset=capital-source",
    "fixture": "tsx src/run-company-enrichment-flow.ts --preset=company --provider=fixture",
    "fixture:icp": "tsx src/run-company-enrichment-flow.ts --preset=company --provider=fixture --icp=examples/icp.sample.json",
    "fixture:capital-source": "tsx src/run-company-enrichment-flow.ts --preset=capital-source --provider=fixture",
    "flow:screen": "bash scripts/run-flow-screen.sh",
    "scrape": "tsx src/scrape-company-websites.ts",
    "packets": "tsx src/prepare-company-llm-packets.ts",
    "enrich": "tsx src/enrich-company-packets.ts --preset=company",
    "enrich:capital-source": "tsx src/enrich-prepared-packets.ts",
    "benchmark": "tsx src/benchmark-site-md-models.ts --preset=company",
    "benchmark:capital-source": "tsx src/benchmark-site-md-models.ts --preset=capital-source",
    "verify:benchmark": "tsx src/verify-site-md-benchmark.ts",
    "ui": "cd ui && npm run dev",
    "ui:build": "cd ui && npm ci && npm run build",
    "restore:pre-cleanup": "bash scripts/restore-cleanup-backup.sh",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/tests/*.test.ts"
  },
  "dependencies": {
    "csv-parse": "^6.2.1",
    "tsx": "^4.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
